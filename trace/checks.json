{
  "note": "trace rehash（port-lang の scripts/trace）が実行する決定論的な検査の登録（ADR e2a4・ADR 9cd9）。各検査は steps を順に実行し、すべて終了コード 0 なら合格とする。covers は覆う Lean の定義で、名前の glob（names）と、適合テストベクタの modelDef とその参照の閉包（vectors。リポジトリからの相対 glob）で書く。Verus・Kani・移植元のオラクルは、それぞれの backlog が足す",
  "checks": [
    {
      "id": "lake-test",
      "description": "適合テストベクタの照合（Lean の Tests。lake test）",
      "steps": [{ "cwd": "lean", "argv": ["lake", "test"] }],
      "covers": { "vectors": ["conformance/**/*.json"], "names": ["SourceModel.Ticket.*"] }
    },
    {
      "id": "pg-master-sql",
      "description": "マスタの Mapper の文・コードリストの SQL の PostgreSQL での差分実行（結果の再生成と lake test の Tests.MasterSql）",
      "steps": [
        { "cwd": ".", "argv": ["tools/ci/master_sql.sh"] },
        { "cwd": "lean", "argv": ["lake", "test"] }
      ],
      "covers": { "names": ["SourceModel.Repository.Schema.*", "SourceModel.Repository.MasterData.*", "SourceModel.Config.*"] }
    },
    {
      "id": "jvm-table",
      "description": "Java の言語意味論と JVM の突き合わせ（表の再生成と Test.LangSemantics の #guard）",
      "steps": [
        { "cwd": ".", "argv": [".agents/skills/port-lang/scripts/ci/jvm_table.sh"] },
        { "cwd": ".agents/skills/port-lang/assets/lean", "argv": ["lake", "build", "+Test.LangSemantics"] }
      ],
      "covers": { "names": ["LangSemantics.Java.*"] }
    },
    {
      "id": "pg-table",
      "description": "SQL の言語意味論と PostgreSQL の突き合わせ（表の再生成と Test.LangSemantics の #guard）",
      "steps": [
        { "cwd": ".", "argv": [".agents/skills/port-lang/scripts/ci/pg_table.sh"] },
        { "cwd": ".agents/skills/port-lang/assets/lean", "argv": ["lake", "build", "+Test.LangSemantics"] }
      ],
      "covers": { "names": ["LangSemantics.Sql.*"] }
    }
  ]
}
