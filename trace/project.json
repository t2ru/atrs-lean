{
  "note": "spec-pivot のスキルの道具（.agents/skills/spec-pivot/scripts）が読む、ATRS 固有の設定（spec-pivot の references/docs/spec/traceability.md#プロジェクトの設定）",
  "skill": ".agents/skills/spec-pivot",
  "lean": {
    "roots": [
      "lean",
      ".agents/skills/spec-pivot/assets/lean"
    ]
  },
  "languages": {
    "source": [
      "java",
      "sql"
    ],
    "target": [
      "rust"
    ]
  },
  "source": {
    "root": "upstream/atrs/JavaConfig-Thymeleaf/atrs",
    "sql_dirs": [
      "atrs-initdb"
    ]
  },
  "target": {
    "root": "rust",
    "src": "rust/src",
    "crate": "atrs",
    "generated": "model"
  },
  "docs": {
    "spec": "docs/spec",
    "abstraction": "docs/spec/abstraction.md",
    "refinement": "docs/spec/refinement.md",
    "traceability": "docs/spec/traceability.md",
    "decision": "docs/decision",
    "backlog": "docs/backlog"
  },
  "conformance": "conformance",
  "ids": {
    "kinds": {
      "adr": [
        "docs/decision",
        ".agents/skills/spec-pivot/references/docs/decision"
      ],
      "backlog": [
        "docs/backlog",
        ".agents/skills/spec-pivot/references/docs/backlog"
      ]
    },
    "isolated": [
      {
        "bundle": ".agents/skills/spec-pivot/references/docs",
        "root": ".agents/skills/spec-pivot"
      }
    ],
    "registers": [
      "docs/spec/abstraction.md",
      "docs/spec/refinement.md"
    ],
    "check_roots": [
      "AGENTS.md",
      "docs/",
      "trace/",
      "lean/",
      "tools/",
      ".agents/",
      "conformance/"
    ],
    "uuid_roots": [
      "AGENTS.md",
      "docs/",
      "trace/",
      ".agents/skills/spec-pivot/references/docs/"
    ],
    "check_skip": [
      ".agents/skills/spec-pivot/scripts/ci/fixtures/",
      "tools/docs/legacy-ids.json",
      "trace/source-inventory.json",
      "trace/target-inventory.json",
      "trace/manifest.json"
    ],
    "legacy": "tools/docs/legacy-ids.json",
    "features": "trace/features.json",
    "backlog_index": "docs/backlog/README.md",
    "exclude": [
      "upstream/"
    ]
  },
  "okf": {
    "note": "spec-pivot の scripts/docs/okf_check.py が検査する OKF v0.2 のバンドルとリンク（spec-pivot の references/docs/rules/maintenance.md#バンドルの検査）",
    "bundles": [
      {
        "root": "docs",
        "profile": {
          "okf_version": true,
          "index_complete": true,
          "common": {
            "required": [
              "title",
              "description",
              "tags"
            ],
            "quoted": [
              "title",
              "description"
            ],
            "title_heading": true
          },
          "rules": [
            {
              "match": "**/README.md",
              "type": "Overview"
            },
            {
              "match": "decision/*.md",
              "type": "Architecture Decision Record",
              "kind": "adr",
              "required": [
                "id",
                "decision_status",
                "date",
                "decision-makers"
              ],
              "sections": [
                "Context and Problem Statement",
                "Decision Drivers",
                "Considered Options",
                "Decision Outcome",
                "More Information"
              ],
              "outcome_markers": [
                "Chosen option",
                "採択"
              ]
            },
            {
              "match": "backlog/*.md",
              "type": "Backlog Item",
              "kind": "backlog",
              "required": [
                "id",
                "state",
                "depends_on"
              ],
              "sections": [
                "目的",
                "範囲",
                "対象外",
                "完了条件",
                "参照"
              ]
            },
            {
              "match": "spec/*.md",
              "type": "Specification",
              "required": [
                "models",
                "spec_role"
              ],
              "enum": {
                "models": [
                  "spec",
                  "source",
                  "target"
                ],
                "spec_role": [
                  "normative",
                  "meta",
                  "draft",
                  "informative"
                ]
              }
            },
            {
              "match": "rules/*.md",
              "type": "Guideline"
            }
          ]
        }
      },
      {
        "root": ".agents/skills/spec-pivot/references/docs",
        "profile": ".agents/skills/spec-pivot/scripts/docs/profiles/spec-pivot.json"
      }
    ],
    "links": {
      "roots": [
        "AGENTS.md",
        "CLAUDE.md",
        "docs",
        ".agents"
      ],
      "absolute": false
    },
    "skip": [
      ".agents/skills/spec-pivot/scripts/ci/fixtures/"
    ]
  }
}
